# Base URL of the Asfour M&R enquiry API (Laravel, /api/v1). Must allow this site's origin via CORS.
NEXT_PUBLIC_ENQUIRY_API_URL=https://project2.gfoura.com/api/v1
# Optional server-side overrides (default to NEXT_PUBLIC_ENQUIRY_API_URL):
# ADMIN_API_URL=https://project2.gfoura.com/api/v1
# CONTENT_API_URL=https://project2.gfoura.com/api/v1
# Shared secret for POST /api/revalidate (backend → site cache refresh). Leave unset to disable.
# REVALIDATE_SECRET=
# Extra hosts allowed to serve media images (comma-separated), e.g. a CDN or S3 bucket domain.
# MEDIA_HOSTS=
